    {
      "value": "\"position\" >= 0 and \"product_id\" > 0\n    and \"quantity\" between 1 and 99 and \"unit_price_paise\" >= 0\n    and \"amount_paise\" = \"unit_price_paise\" * \"quantity\"",
      "name": "order_items_values_check",
      "entityType": "checks",
      "schema": "public",
      "table": "order_items"
    },
    {
      "value": "\"status\" in ('New', 'Contacted', 'Confirmed', 'Preparing', 'Out for delivery', 'Ready for pickup', 'Completed', 'Cancelled')",
      "name": "order_requests_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "order_requests"
    },
    {
      "value": "\"fulfilment\" in ('delivery', 'pickup')",
      "name": "order_requests_fulfilment_check",
      "entityType": "checks",
      "schema": "public",
      "table": "order_requests"
    },
    {
      "value": "\"season\" between 2000 and 9999",
      "name": "order_requests_season_check",
      "entityType": "checks",
      "schema": "public",
      "table": "order_requests"
    },
    {
      "value": "\"subtotal_paise\" >= 0 and \"discount_paise\" >= 0\n    and \"delivery_charge_paise\" >= 0 and \"total_paise\" >= 0\n    and \"discount_percent\" between 0 and 100\n    and \"total_paise\" = \"subtotal_paise\" - \"discount_paise\" + \"delivery_charge_paise\"",
      "name": "order_requests_money_check",
      "entityType": "checks",
      "schema": "public",
      "table": "order_requests"
    },
    {
      "value": "\"to_status\" in ('New', 'Contacted', 'Confirmed', 'Preparing', 'Out for delivery', 'Ready for pickup', 'Completed', 'Cancelled')\n    and (\"from_status\" is null or \"from_status\" in ('New', 'Contacted', 'Confirmed', 'Preparing', 'Out for delivery', 'Ready for pickup', 'Completed', 'Cancelled'))",
      "name": "order_status_history_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "order_status_history"
    }
